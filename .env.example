# صرافی منبع داده (binance / kucoin / okx / mexc ...)
# نکته: binance از سرورهای آمریکا (مثل Codespaces) بلاک است؛ آنجا kucoin بگذارید
EXCHANGE=binance

# رمز ورود به سایت (اختیاری ولی برای سرور عمومی شدیداً توصیه می‌شود)
APP_USER=admin
APP_PASSWORD=

# فقط برای ربات تلگرام (اختیاری)
BOT_TOKEN=
ADMIN_ID=0
AUTO_INTERVAL_SEC=3600
